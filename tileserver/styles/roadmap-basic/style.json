{
  "version": 8,
  "name": "RoadMap Basic",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{china}"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#edf1f2"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dce9d5",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e8dfcf",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe8c4",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9ecae1"
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#8a8f98",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.5,
          10,
          1.2
        ],
        "line-opacity": 0.55
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "minor",
            "service",
            "track",
            "path"
          ]
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.4,
          16,
          4
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "primary",
            "secondary",
            "tertiary",
            "trunk",
            "motorway"
          ]
        ]
      ],
      "paint": {
        "line-color": "#f8f6f0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.6,
          12,
          2.4,
          16,
          8
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#c9c1b6",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "water-name-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 8,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#2f7194",
        "text-halo-color": "#edf6fa",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-name-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          10,
          16,
          14
        ]
      },
      "paint": {
        "text-color": "#5c5c5c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name_int"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          8,
          14,
          12,
          18
        ],
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#1f2933",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
